      "scope": "9311",
      "route": "registered_adapter",
      "adapter_id": "plant_9311",
      "capabilities": [
        "embedding",
        "mlm",
        "annotation_transfer",
        "marker_candidates",
        "species_adapter_execution",
        "shared_embedding_inference"
      ],
      "required_inputs": [
        "cell_expression",
        "species_context",
        "central_embedding"
      ],
      "outputs": [
        "cell_labels",
        "cell_confidence",
        "cell_embeddings",
        "marker_candidates"
      ],
      "evidence_requirements": [
        "adapter_manifest",
        "gene_identifier_audit",
        "prediction_contract"
      ],
      "fallback_chain": [
        "specialist.orthology_transfer",
        "specialist.open_set"
      ],
      "version": "1.0.0"
